# Adresse, auf der das Web-Interface lauscht. Die LAN-Adresse dieses Rechners,
# nicht 0.0.0.0 - das UI entscheidet, was von aussen erreichbar ist.
GW_LISTEN=10.10.10.20:8080

# Anmeldung am Web-Interface.
GW_USER=admin
# Hash erzeugen mit:  docker compose run --rm sunshine-gw hash-password
# Das Passwort wird zweimal abgefragt und dabei nicht angezeigt; die Ausgabe ist die
# komplette Zeile, die hier hin gehoert. Sie enthaelt bewusst nur [A-Za-z0-9._-] und
# braucht daher keine Anfuehrungszeichen.
GW_PASSWORD_HASH=

TZ=Europe/Berlin
